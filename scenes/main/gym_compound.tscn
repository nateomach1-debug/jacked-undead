[gd_scene load_steps=753 format=3]

; ============================================================
; IRON TOMB ATHLETIC CLUB  —  gym-themed zombies map
; Drop-in companion / replacement for main.tscn
; Same scripts, stations, weapons, HUD, round manager.
;
; FLOORS
;   Basement y=-5   Ground y=0   Mezzanine / Floor 2 y=5
;   Building bounds  x=-30..30   z=-26..32   (~60m x 58m)
;
; GROUND AREAS
;   Lobby Atrium (spawn)     x=-10..10   z=-26..-6
;   Locker Room              x=-30..-10  z=-26..-16
;   Wet Area / Sauna         x=-30..-10  z=-16..-6
;   Group Fitness Studio     x=10..30    z=-26..-16
;   Juice Bar                x=10..30    z=-16..-6
;   Iron Pit (free weights)  x=-30..0    z=-6..18
;   Cardio Theater           x=0..30     z=-6..18
;   Pool Deck + empty pool   x=-30..30   z=18..32
;
; FLOOR 2
;   Functional Box           west-north
;   Recovery Spa             west-mid (over iron overlook)
;   Olympic Platforms        east-north
;   Spin Studio              east-mid
;   Indoor track / pool mezzanine  south
;
; BASEMENT
;   Boiler west, cages east, pump south, staff halls
;
; VERTICAL
;   Twin grand stairs in lobby atrium  (ground <-> F2)
;   Iron Pit overlook stairs           (ground <-> F2)
;   SW well in Iron Pit                (ground <-> basement)
;   SE well on pool deck               (ground <-> basement)
;   Pool stairs into empty basin
;
; HOW TO USE
;   Save this file as res://scenes/main/gym_compound.tscn
;   or replace your existing main.tscn.
;   Shotgun wall-buy uses the SMG display model (no shotgun glTF in original).
; ============================================================

