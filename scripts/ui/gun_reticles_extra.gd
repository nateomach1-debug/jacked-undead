const LINES: Dictionary = {
    "gun_repeater_crossbow": [
        [[-0.11, 0.0, -0.34], [-0.52, 0.0, 0.0], [-0.11, 0.0, 0.34]],
    ],
}

static var _built: Dictionary = {}


static func shapes() -> Dictionary:
    if _built.is_empty():
        for id in GUNS.keys():
            _built[id] = _build(str(id))
    return _built


static func _proj(f: float, u: float, l: float) -> Vector2:
    return Vector2(0.656 * f - 0.0316 * u + 0.754 * l, -0.2387 * f - 0.9565 * u + 0.1676 * l)


static func _faces(b: Array) -> Array:
    var f0: float = b[0]
    var f1: float = b[1]
    var u0: float = b[2]
    var u1: float = b[3]
    var l0: float = b[4]
    var l1: float = b[5]
    var sk: float = b[6]
    return [
        [_proj(f0, u1, l0), _proj(f0, u1, l1), _proj(f1, u1, l1), _proj(f1, u1, l0)],
        [_proj(f0 + sk, u0, l1), _proj(f1 + sk, u0, l1), _proj(f1, u1, l1), _proj(f0, u1, l1)],
        [_proj(f0 + sk, u0, l0), _proj(f0 + sk, u0, l1), _proj(f0, u1, l1), _proj(f0, u1, l0)],
    ]


static func _build(id: String) -> Array:
    var polys: Array = []
    var lines: Array = []
    var min_x: float = 0.0
    var max_y: float = 0.0
    for b in GUNS[id]:
        for face in _faces(b):
            polys.append(face)
            for p: Vector2 in face:
                min_x = minf(min_x, p.x)
                max_y = maxf(max_y, p.y)
    if LINES.has(id):
        for ln in LINES[id]:
            var pline: Array = []
            for q in ln:
                var pq: Vector2 = _proj(q[0], q[1], q[2])
                pline.append(pq)
                min_x = minf(min_x, pq.x)
                max_y = maxf(max_y, pq.y)
            lines.append(pline)
    var sc: float = 9.0
    if min_x < -0.01:
        sc = minf(sc, 1.3 / -min_x)
    if max_y > 0.01:
        sc = minf(sc, 1.15 / max_y)
    var out: Array = []
    for face in polys:
        var pts: Array = []
        for p: Vector2 in face:
            pts.append([snappedf(p.x * sc, 0.001), snappedf(p.y * sc, 0.001)])
        out.append({"t": "poly", "p": pts})
    for pl in lines:
        var pts2: Array = []
        for p: Vector2 in pl:
            pts2.append([snappedf(p.x * sc, 0.001), snappedf(p.y * sc, 0.001)])
        out.append({"t": "polyline", "p": pts2, "w": 1.0})
    out.append({"t": "circle", "c": [0.0, 0.0], "r": 0.03, "fill": true})
    return out
